{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AT-SPI Case Mapping Output",
  "description": "Per-module output from LLM Phase 2. One file per module.",
  "type": "object",
  "required": ["meta", "suites"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["app", "module", "module_slug", "module_short"],
      "properties": {
        "app": {"type": "string"},
        "module": {"type": "string"},
        "module_slug": {"type": "string"},
        "module_short": {"type": "string"},
        "case_count": {"type": "integer"}
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "steps"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "annotation": {
            "type": "object",
            "properties": {
              "测试界面": {"type": "string"},
              "测试功能": {"type": "string"},
              "前置条件": {"type": "string"},
              "AT元素引用": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["step_type", "action"],
              "properties": {
                "step_type": {
                  "type": "string",
                  "enum": ["action", "assert"]
                },
                "action": {"type": "string"},
                "description": {"type": "string"},
                "selector": {
                  "type": "object",
                  "properties": {
                    "name": {"type": "string"},
                    "role": {"type": "string"}
                  }
                },
                "do": {"type": "string"},
                "items": {
                  "type": "array",
                  "items": {"type": "string"}
                },
                "key": {
                  "oneOf": [
                    {"type": "string"},
                    {"type": "array", "items": {"type": "string"}}
                  ]
                },
                "text": {"type": "string"},
                "path": {"type": "string"},
                "time": {"type": "number"},
                "wait": {"type": "number"},
                "process_name": {"type": "string"},
                "assertion": {"type": "string"},
                "template": {"type": "string"},
                "value": {"type": "string"},
                "direction": {"type": "string"},
                "amount": {"type": "integer"},
                "x": {"type": "integer"},
                "y": {"type": "integer"}
              }
            }
          }
        }
      }
    }
  }
}